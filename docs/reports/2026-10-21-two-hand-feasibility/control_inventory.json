  "signal_policy": {
    "layout": "sdl3-gamepad-core-v1",
    "axis_mappings": [
      "left_x",
      "left_y",
      "right_x",
      "right_y"
    ],
    "scalar_mappings": [
      "left_trigger",
      "right_trigger",
      "south",
      "east",
      "west",
      "north",
      "back",
      "guide",
      "start",
      "left_stick",
      "right_stick",
      "left_shoulder",
      "right_shoulder"
    ],
    "split_mappings": {
      "dpad_horizontal": [
        "dpad_left",
        "dpad_right"
      ],
      "dpad_vertical": [
        "dpad_up",
        "dpad_down"
      ]
    },
    "physical_only": [
      "pair_bind_connect"
    ],
    "button_output": "continuous [0,1] travel fraction; consuming task chooses a digital threshold",
    "stick_neutral_epsilon": 0.02,
    "device_neutral_epsilon": 0.0001,
    "device_neutral_mode": "zero_inside_without_rescaling_outside",
    "device_neutral_applies_to": [
      "left and right trigger normalized travel",
      "button normalized travel",
      "D-pad normalized rocker magnitude"
    ],
    "derivation": "2026-10-12 owner-selected 0.02 radial stick deadzone for simulation/game input. With the unchanged owner-selected PhysX tilt-joint friction coefficient 0.1, spring return can stop at normalized residuals about 0.005–0.0101; 0.02 leaves margin. This is a simulation setting, not a measured hardware value. Inside the radial deadzone output is zero, outside it values are not rescaled. The 2026-10-09 shake-experiment friction provenance is retained in control_groups.sticks.tilt_joint_friction_basis; the remaining 1e-4 device epsilon is unchanged.",
    "external_behavior_references": {
      "microsoft_xinput": {
        "url": "https://learn.microsoft.com/en-us/windows/win32/xinput/getting-started-with-xinput#dead-zone",
        "observation": "Microsoft assigns dead-zone filtering to the application and calls post-dead-zone normalization optional."
      },
      "sdl3": {
        "url": "https://wiki.libsdl.org/SDL3/SDL_GetGamepadAxis",
        "observation": "SDL_GetGamepadAxis returns the current signed 16-bit axis state and documents zero as a valid centered value; it does not specify an automatic dead-zone transform."
      },
      "w3c_gamepad": {
        "url": "https://w3c.github.io/gamepad/#remapping",
        "observation": "The Gamepad specification linearly normalizes logical axis values to [-1,1]; it does not define a gameplay dead-zone remap."
      }
    },
    "dpad_contact_closure": {
      "threshold": 0.3,
      "unit": "normalized fraction of full travel (dimensionless)",
      "status": "Unmeasured; test value",
      "hardware_measured": false,
      "rule": "Independently suppress each split D-pad channel below threshold; preserve amplitude at/above threshold, including true diagonals.",
      "reason": "30% separates small solver/contact cross-axis motion from intentional contact closure; selected for simulation testing, not inferred from measured Xbox switches.",
      "uncertainty": "No physical switch closure-angle measurement; the fraction may vary by direction, hysteresis, manufacturing tolerance and wear. A shared threshold is provisional.",
      "calibration": "Measure rocker angle/normalized travel while separately monitoring each electrical contact on repeated press/release cycles, including diagonals; estimate per-direction close/open thresholds and hysteresis, then replace this test value."
    },
    "stick_neutral_history": [
      {
        "value": 0.01,
        "unit": "normalized radial magnitude",
        "status": "previous owner-selected simulation setting",
        "derivation": "The 0.01 radial stick deadzone is the owner-selected simulation/game-input threshold. Stick values inside it are zeroed and values outside are not rescaled. The remaining 1e-4 device epsilon only clears solver residue on triggers, buttons and D-pad; it is not a measured hardware deadzone."
      }
    ]
